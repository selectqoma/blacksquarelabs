{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-apps-challenge"
    }
  ],
  "headers": [
    {
      "source": "/assets/feya-bg.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
